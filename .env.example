# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_NAME=swimming_pool
DB_PORT=5432

# --- Session ---
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# --- App ---
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Email (for "Forgot Password" links) ---
# Leave these blank for local development — reset links will just be printed
# to the terminal instead of emailed. Fill them in to send real emails
# (e.g. with Gmail App Passwords, SendGrid, Mailgun, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
