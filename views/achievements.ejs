<%- include('partials/header', { pageTitle: swimmer.name + ' - Achievements' }) %>

<div class="container">
    <h1>🏆 <%= swimmer.name %>'s Achievements</h1>
    <% if (swimmer.owner_username) { %>
        <p class="no-bookings" style="font-style:normal;">Parent account: <%= swimmer.owner_username %></p>
    <% } %>

    <% if (error) { %>
        <div class="error-message"><%= error %></div>
    <% } %>

    <% if (canManage) { %>
    <div class="card">
        <h3>Add an Achievement</h3>
        <form action="/swimmers/<%= swimmer.id %>/achievements" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="title" placeholder="e.g. Completed Stage 3, 25m Freestyle Badge" required>
            <input type="text" name="description" placeholder="Optional note (date, coach, details...)">
            <input type="file" name="file" accept="image/jpeg,image/png,image/webp,application/pdf" required>
            <button type="submit" class="btn-add">📤 Upload</button>
        </form>
        <p class="no-bookings">JPG, PNG, WEBP, or PDF — max 5MB.</p>
    </div>
    <% } %>

    <div class="card">
        <h3>Gallery</h3>
        <% if (achievements.length === 0) { %>
            <p class="no-bookings">
                No achievements uploaded yet 😔
                <% if (!canManage) { %>Check back after your next lesson!<% } %>
            </p>
        <% } else { %>
        <div class="sessions-grid">
            <% achievements.forEach(a => { %>
                <div class="session-card">
                    <% if (a.file_type === 'image') { %>
                        <a href="<%= a.file_path %>" target="_blank" rel="noopener">
                            <img src="<%= a.file_path %>" alt="<%= a.title %>" style="width:100%; border-radius:8px; display:block; margin-bottom:10px;">
                        </a>
                    <% } else { %>
                        <a href="<%= a.file_path %>" target="_blank" rel="noopener" class="btn-book" style="display:block; text-align:center; margin-bottom:10px;">📄 View Certificate (PDF)</a>
                    <% } %>
                    <strong><%= a.title %></strong>
                    <% if (a.description) { %>
                        <p><%= a.description %></p>
                    <% } %>
                    <p style="opacity:0.7; font-size:13px;"><%= new Date(a.created_at).toLocaleDateString() %></p>
                    <% if (canManage) { %>
                    <form action="/swimmers/<%= swimmer.id %>/achievements/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Remove this achievement?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-cancel">❌ Remove</button>
                    </form>
                    <% } %>
                </div>
            <% }) %>
        </div>
        <% } %>
    </div>

    <a href="<%= canManage ? '/admin/swimmers' : '/swimmers' %>" class="back">⬅ Back to Swimmers</a>
</div>

<%- include('partials/footer') %>
