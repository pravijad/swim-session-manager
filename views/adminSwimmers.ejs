<%- include('partials/header', { pageTitle: 'All Swimmers' }) %>

<div class="container">
    <h1>👥 All Swimmers</h1>
    <p class="no-bookings" style="font-style:normal;">Manage every swimmer's achievements and certificates from here.</p>

    <div class="card">
        <% if (swimmers.length === 0) { %>
            <p class="no-bookings">No swimmers registered yet 😔</p>
        <% } else { %>
        <table>
            <tr><th>Swimmer</th><th>Age</th><th>Parent Account</th><th>Achievements</th></tr>
            <% swimmers.forEach(s => { %>
                <tr>
                    <td><%= s.name %></td>
                    <td><%= s.age %></td>
                    <td><%= s.owner_username %></td>
                    <td>
                        <a href="/swimmers/<%= s.id %>/achievements" class="btn-book">🏆 Manage (<%= s.achievement_count %>)</a>
                    </td>
                </tr>
            <% }) %>
        </table>
        <% } %>
    </div>

    <a href="/admin/dashboard" class="back">⬅ Back to Admin Dashboard</a>
</div>

<%- include('partials/footer') %>
